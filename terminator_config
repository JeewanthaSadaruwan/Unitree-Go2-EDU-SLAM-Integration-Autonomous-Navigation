[global_config]
  title_hide_sizetext = True
  
[keybindings]
  
[profiles]
  [[default]]
    background_darkness = 0.9
    background_type = transparent
    cursor_color = "#aaaaaa"
    font = Monospace 11
    use_system_font = False
    
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
      
  [[go2_slam]]
    [[[window0]]]
      type = Window
      parent = ""
      size = 1920, 1080
    [[[child1]]]
      type = VPaned
      parent = window0
    [[[child2]]]
      type = HPaned
      parent = child1
    [[[child3]]]
      type = HPaned
      parent = child1
    [[[terminal1]]]
      type = Terminal
      parent = child2
      profile = default
      command = /usr/bin/python3 ~/odom/odom_to_tf.py
    [[[terminal2]]]
      type = Terminal
      parent = child2
      profile = default
      command = bash -c 'source /opt/ros/foxy/setup.bash && ros2 run tf2_ros static_transform_publisher 0 0 0 0 0 0 base_link base_footprint; exec bash'
    [[[terminal3]]]
      type = Terminal
      parent = child3
      profile = default
      command = bash -c 'source /opt/ros/foxy/setup.bash && source ~/odom/install/setup.bash && ros2 launch go2_mapping pointcloud_to_laserscan.launch.py; exec bash'
    [[[terminal4]]]
      type = Terminal
      parent = child3
      profile = default
      command = bash -c 'source /opt/ros/foxy/setup.bash && sleep 5 && ros2 launch slam_toolbox online_async_launch.py slam_params_file:=/home/unitree/odom/src/go2_mapping/config/slam_params_go2.yaml; exec bash'
      
[plugins]
